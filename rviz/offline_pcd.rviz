Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.3
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 200
      Reference Frame: <Fixed Frame>
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Name: Input Cloud
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic: /cloud_offline
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    - Alpha: 0.85
      Autocompute Intensity Bounds: false
      Autocompute Value Bounds:
        Max Value: 2
        Min Value: -2
        Value: true
      Class: grid_map_rviz_plugin/GridMap
      Color: 200; 200; 200
      Color Layer: traversability
      Color Transformer: GridMapLayer
      Enabled: true
      Height Layer: elevation
      Height Transformer: GridMapLayer
      History Length: 1
      Invert Rainbow: true
      Max Color: 0; 255; 0
      Max Intensity: 1
      Min Color: 255; 0; 0
      Min Intensity: 0
      Name: GridMap Traversability
      Show Grid Lines: false
      Topic: /elevation_grid_map_offline
      Unreliable: false
      Use Rainbow: true
      Value: true

    - Alpha: 0.85
      Autocompute Intensity Bounds: true
      Class: grid_map_rviz_plugin/GridMap
      Color: 200; 200; 200
      Color Layer: elevation
      Color Transformer: GridMapLayer
      Enabled: false
      Height Layer: elevation
      Height Transformer: GridMapLayer
      History Length: 1
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 10
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: GridMap Elevation
      Show Grid Lines: false
      Topic: /elevation_grid_map_offline
      Unreliable: false
      Use Rainbow: true
      Value: false

    - Alpha: 0.85
      Autocompute Intensity Bounds: false
      Class: grid_map_rviz_plugin/GridMap
      Color: 200; 200; 200
      Color Layer: slope
      Color Transformer: GridMapLayer
      Enabled: false
      Height Layer: elevation
      Height Transformer: GridMapLayer
      History Length: 1
      Max Color: 255; 0; 0
      Max Intensity: 0.8
      Min Color: 0; 255; 0
      Min Intensity: 0.0
      Name: GridMap Slope
      Show Grid Lines: false
      Topic: /elevation_grid_map_offline
      Use Rainbow: true
      Value: false

    - Alpha: 0.85
      Autocompute Intensity Bounds: false
      Class: grid_map_rviz_plugin/GridMap
      Color: 200; 200; 200
      Color Layer: roughness
      Color Transformer: GridMapLayer
      Enabled: false
      Height Layer: elevation
      Height Transformer: GridMapLayer
      History Length: 1
      Max Color: 255; 0; 0
      Max Intensity: 0.3
      Min Color: 0; 255; 0
      Min Intensity: 0.0
      Name: GridMap Roughness
      Show Grid Lines: false
      Topic: /elevation_grid_map_offline
      Use Rainbow: true
      Value: false

    - Alpha: 0.6
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Occupancy (2D)
      Topic: /occupancy_map_offline
      Unreliable: false
      Use Timestamp: false
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 80
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Overview
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Invert Z Axis: false
        Name: Top Down
        Near Clip Distance: 0.01
        Scale: 10
        Target Frame: <Fixed Frame>
        Value: TopDownOrtho (rviz)
        X: 0
        Y: 0
Window Geometry:
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1600
  X: 0
  Y: 0
